# MaxGraph — настройки (.env)
# Скопируй в .env рядом с docker-compose.yml. Всё опционально: без единой
# настройки сервер работает из коробки. .env в .gitignore — не коммить.

# Токен доступа (MCP/REST/дашборд /app). Пусто → сгенерируется сам при первом
# запуске (data/local_token.txt)
MEMORY_TOKEN=

# Ключ лицензии mg_… из кабинета — активирует Pro без дашборда
# (удобно для сервера без браузера)
LICENSE_KEY=

# sha256 железа хоста (64 hex) — ставится установщиком, стабильный id машины.
# Не меняй после установки
HOST_FP=

# Метка способа установки (docker|docker-desktop|python; rancher — легаси) —
# ставится установщиком, уходит в анонимный install-ping. Пусто → определяется само
INSTALL_FLAVOR=

# Версия готового образа GHCR — ставится установщиком из VERSION. Пусто → latest
MG_VERSION=

# Доверять X-Forwarded-For — 1, только если перед сервером стоит ТВОЙ
# reverse-proxy (nginx). Иначе не трогай
TRUST_PROXY=

# --- Семантический поиск (опционально, по умолчанию выключен) ---
# Свой OpenAI-compatible эндпоинт эмбеддингов (например, локальный). Без этих
# двух переменных — чистый полнотекстовый поиск.
EMBED_URL=
EMBED_KEY=
# Модель эмбеддингов (default text-embedding-v3). Смена модели пересчитает
# вектора сама
EMBED_MODEL=
# Таймаут одного запроса, сек (default 10)
EMBED_TIMEOUT=
# Период фонового обновления векторов, сек (default 300)
EMBED_REFRESH_SEC=
# Кап токенов эмбеддингов в день (default 200000)
EMBED_DAILY_CAP=
# Вес векторной части в поиске, 0..1 (default 0.6; 0 — только полнотекст)
HYBRID_VECTOR_WEIGHT=

# --- Подстройка ранжирования (по умолчанию включено) ---
# Частые и недавние записи всплывают выше. Потолок буста (default 0.25;
# 0 — выключить совсем)
ACTR_MAX_BOOST=
# Полураспад фактора свежести в днях (default 14)
ACTR_HALF_LIFE_DAYS=
# Как часто сбрасывать счётчики на диск, сек (default 300)
ACTR_FLUSH_SEC=

# --- Автообновления (по умолчанию включены) ---
# 0 — выключить (тогда в лог пишется только «доступна версия»)
AUTO_UPDATE=1
# Откуда проверять обновления (пусто → официальный источник; для своего зеркала)
STORE_URL=
# Как часто проверять, сек (пусто → 3600 = раз в час; меньше 300 нельзя)
CHECK_INTERVAL=
