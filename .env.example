# Maxgraph — env
# Скопируй в .env и заполни. .env в .gitignore — не коммить.

# Мастер-токен (MCP/REST/дашборд /app). Необязателен с v0.14:
# пусто → сервер сам сгенерирует mg_local_* при первом запуске (data/local_token.txt)
MEMORY_TOKEN=

# Анонимная телеметрия: install-ping при старте (install_id + версия) и
# learn-events (v0.26.0): пакет «поисковый запрос → открытый заголовок» раз в 5 мин —
# без ключа/ID/IP, содержимое памяти не отправляется. 0 — отключить оба
TELEMETRY=1

# Магазин (опционально для self-hosted Free; нужны для rezon-ai.ru-магазина)
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
# Секрет вебхука: callback URL в кабинете Platega = https://<домен>/billing/webhook/platega?secret=<это значение>
PLATEGA_WEBHOOK_SECRET=

# Base URL Platega API (официальный — https://app.platega.io; менять только для прокси/тестов)
PLATEGA_API_BASE=https://app.platega.io
# Валюта цен на /billing/create: RUB (pro=390, team=1150) или USD (pro=4, team=12)
PLATEGA_CURRENCY=RUB
# Публичный базовый URL сервера — для return-ссылок оплаты (/billing/success?pid=…)
PUBLIC_BASE_URL=https://rezon-ai.ru

# --- Триал и лицензии (self-hosted) ---
# Длина триала в днях с первого запуска (default 7). Потом мутации блокируются,
# чтение и /api/export остаются доступны всегда.
TRIAL_DAYS=7
# Ключ HMAC-подписи license.json и license keys. Если пусто — генерируется при первом
# запуске и сохраняется в DATA_DIR/.hmac_key (забэкапь его: потеря = невалидные ключи).
LICENSE_HMAC_SECRET=
# sha256-хеш железа ХОСТА (64 hex) — стабильный fingerprint машины для триала и
# лицензии. Вычисляется установщиком ДО docker compose up (см. AGENTS.md /
# docs/PAIRING.md). Пусто — fingerprint считается по контейнеру (старое поведение,
# менее стабилен при пересоздании контейнера). Не перезаписывать при переустановке.
HOST_FP=

# --- Digiseller per-order (генерация кода по заказу, v0.7) ---
# Shared secret для /billing/digiseller/gen (НЕ API key Digiseller!). В кабинете
# Digiseller в «Содержимое → данные от вашего сервера» вписать URL:
#   https://rezon-ai.ru/billing/digiseller/gen?key=<это значение>
DIGISELLER_GEN_SECRET=
# Схема проверки запроса: url-key (default — секрет в URL) | md5 | md5-full
# (md5(secret+order+amount+currency)) | sha256-full | hmac-sha256 (по всем полям).
# Можно списком через запятую — примется первая подошедшая.
DIGISELLER_SIGN_SCHEME=url-key
# Формат ответа Digiseller: text (default — сырой код в теле) | json | xml
DIGISELLER_RESPONSE_FORMAT=text
# Ожидаемый product_id товара с генерацией (запрос с другим товаром → отказ). Пусто = без проверки.
DIGISELLER_PRODUCT_ID=XXXXXXXX

# --- Digiseller уведомления (продажа/сообщения → лог + Telegram, v0.9.1) ---
# Секрет в URL приёмника: в кабинете Digiseller (Уведомления → URL) вписать:
#   https://rezon-ai.ru/webhook/digiseller/sale?key=<это значение>     (метод POST)
#   https://rezon-ai.ru/webhook/digiseller/message?key=<это значение>  (метод POST)
DIGISELLER_HOOK_SECRET=
# Куда слать Telegram-уведомления (chat id; узнать: @userinfobot). Пусто = только лог.
TG_NOTIFY_CHAT_ID=

# --- GitHub webhook витрины (звёзды/форки/issues/PR/релизы → Telegram, v0.33.0) ---
# Только магазин (STORE_MODE=1). Секрет из настроек репо:
#   github.com/RuMemory/maxgraph → Settings → Webhooks → https://rezon-ai.ru/api/hooks/github
#   Content-Type: application/json, Secret = это значение
GITHUB_HOOK_SECRET=

# --- Доставка кода покупателю (оба канала best-effort; код всегда есть на /billing/success) ---
# SMTP с STARTTLS (порт 465 = SSL). Без SMTP_HOST письма просто не шлются.
# Локальный postfix на том же VPS (docker bridge): SMTP_HOST=172.18.0.1 SMTP_PORT=25 SMTP_STARTTLS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=1
# Telegram-бот для доставки кода (chat id покупателя передаётся из платёжного потока;
# также включает deep-link доставку: t.me/<бот>?start=<ref> → код в личку)
TG_BOT_TOKEN=

# --- Режим инстанса (v0.11) ---
# STORE_MODE=1 — публичный магазин: /api/license/activate убирается из публичных путей
# (self-hosted инстансам оставить пустым — им activate нужен открытым)
STORE_MODE=
# TRUST_PROXY=1 — доверять X-Forwarded-For (ставить ТОЛЬКО за своим reverse-proxy, nginx)
TRUST_PROXY=

# --- ACT-R reinforcement (В2.3, default ON): частые/недавние обращения поднимают ---
# --- сущность в поиске и секциях session_start. Счётчики в data/access.json. ---
# Потолок буста ранга (default 0.25 = +25%; 0 — полностью выключить)
ACTR_MAX_BOOST=
# Полураспад recency-фактора в днях (default 14)
ACTR_HALF_LIFE_DAYS=
# Секунды между flush счётчиков в access.json (default 300; + flush при shutdown)
ACTR_FLUSH_SEC=

# --- Семантический поиск (В2.2, опционально): гибрид FTS+косинус по векторам ---
# Без EMBED_URL/EMBED_KEY молча выключен (чистый FTS, поведение как раньше).
# READONLY-зеркало пополнителя не запускает, поиск по завезённому ресинком
# data/embeddings.json работает. Zero-config: embed.configure_runtime(url, key,
# model) из кода перекрывает эти значения без рестарта (приоритет над env).
# OpenAI-compatible endpoint (base …/v1 или полный …/embeddings)
EMBED_URL=
EMBED_KEY=
# Модель эмбеддингов (default text-embedding-v3). Смена модели инвалидирует
# вектора в embeddings.json (отпечаток "_model") — пополнитель пересчитает сам
EMBED_MODEL=
# Секунд на один /embeddings запрос (default 10)
EMBED_TIMEOUT=
# Период фонового пополнителя векторов, сек (default 300)
EMBED_REFRESH_SEC=
# Кап токенов эмбеддингов в UTC-день (default 200000, оценка len/4)
EMBED_DAILY_CAP=
# Вес векторной составляющей w в score=(1−w)·fts+w·cos (default 0.6; 0 — чистый FTS)
HYBRID_VECTOR_WEIGHT=

# --- Автообновления (sidecar-контейнер maxgraph-updater) ---
# По умолчанию ВКЛЮЧЕНО: раз в час сверяет версию с магазином и ставит релиз
# сам (ed25519-подпись + sha256 tarball'а, бэкап data/, авто-откат при провале
# healthcheck). С v0.22.0 — watchtower-style: пути хоста не нужны вообще,
# работает на Docker Desktop Windows/macOS и Linux (образ собирается через
# docker API, контейнер пересоздаётся клонированием по inspect).
# 0 — выключить (тогда только пишет «доступна версия» в лог).
AUTO_UPDATE=1
# Откуда проверять обновления (пусто → https://rezon-ai.ru; для своего зеркала)
STORE_URL=
# Как часто проверять, секунд (пусто → 3600 = раз в час; ниже 300 не опустить —
# анти-tight-loop floor в updater.sh)
CHECK_INTERVAL=
